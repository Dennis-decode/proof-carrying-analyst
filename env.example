# Copy this file to ".env" and fill in ONE provider. Never commit ".env".
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste_your_key_here
# GROQ_API_KEY=paste_your_key_here
# ANTHROPIC_API_KEY=paste_your_key_here
# Optional: override the model name if the default is rejected
# LLM_MODEL=gemini-3.5-flash
# Use LLM_PROVIDER=mock to test the plumbing with NO api key (answers only a few demo questions)
